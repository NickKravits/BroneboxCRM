#!/bin/bash
# Автоматически запускается после каждого "git pull" (если хуки подключены —
# см. инструкцию в README.md). Обновляет ?v=... у CSS/JS во всех index.html,
# чтобы у пользователей всё подтянулось само, без ручной очистки кэша.
#
# НЕ коммитит результат — раньше коммитил здесь же, но из-за этого каждый
# git pull (в том числе изнутри deploy.sh) создавал новый локальный коммит,
# который конфликтовал со следующим деплоем на тех же строках ?v=... .
# Коммит версии теперь делает только deploy.sh, который сначала сбрасывает
# предыдущий бамп и только потом тянет и коммитит заново — тогда конфликтовать
# нечему. Если кто-то всё же вызовет голый "git pull" — версия просто
# останется незакоммиченной до следующего deploy.sh, ничего не сломается.
cd "$(dirname "$0")/.."
bash bump-version.sh
