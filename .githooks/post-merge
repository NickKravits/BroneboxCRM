#!/bin/bash
# Автоматически запускается после каждого "git pull" (если хуки подключены —
# см. инструкцию в README.md). Обновляет ?v=... у CSS/JS во всех index.html,
# чтобы у пользователей всё подтянулось само, без ручной очистки кэша.
#
# Коммитит бамп версии сразу же — если оставить его незакоммиченным, он тихо
# продолжит указывать на старый коммит после первого же пропущенного запуска
# хука (именно так один раз уже "потерялась" версия в проде).
cd "$(dirname "$0")/.."
bash bump-version.sh

if ! git diff --quiet -- '*index.html' crm/version.json; then
  git add -- '*index.html' crm/version.json
  git commit -m "chore: bump asset version" --quiet --no-verify
  echo "Версия закоммичена."
fi
